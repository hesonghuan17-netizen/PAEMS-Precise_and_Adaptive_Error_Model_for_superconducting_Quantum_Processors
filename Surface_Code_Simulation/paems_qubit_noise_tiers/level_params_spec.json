{
  "_metadata": {
    "name": "PAEMS qubit noise tier specification",
    "version": "1.0",
    "created": "2026-04-27",
    "description": "4-tier noise parameter specification for synthetic PAEMS surface-code simulation. Each tier represents an industry quality level. Per-qubit/per-CX values are sampled from normal distributions with the (mean, std) given here.",
    "tiers": {
      "L1": "Next-generation (5-7 years out, 2-3x better than L2)",
      "L2": "Current state-of-art (Heron r3 / Willow / Zuchongzhi 3.x, 2024-2025)",
      "L3": "Current mainstream (Heron r2 / Heron r1 / Zuchongzhi 3.0)",
      "L4": "Current poor or older generation (Eagle r3 / Origin Wukong-180 / Sycamore-era)"
    },
    "data_sources": [
      "IBM 10-chip CSV calibrations (boston/pittsburgh/aachen/kingston/marrakesh/fez/berlin/miami/brussels/strasbourg)",
      "Google Willow Nature 2024 spec sheet",
      "USTC Zuchongzhi 3.0 / 3.2 papers (2024-2025)",
      "Origin Quantum Wukong-180 chip data (2026)"
    ],
    "constraints": {
      "physical": "All time params > 0; all probability params in [0, 1]; all fidelities in [0.5, 1]; T2 <= 2*T1",
      "approx": "measurement_spam_rate.mean ~ data_init_error.mean + data_measurement_error.mean (loose, per-qubit may deviate)",
      "leakage_disabled": "lp / sp / lp_propagation_prob set to 0 in this version (classical noise only)",
      "crosstalk_v2": "Removed crosstalk_global. Crosstalk now ONLY through crosstalk_pairs (freq + distance based). Pairs without entry experience zero crosstalk. Use gen_pair_overrides.py to populate, or write crosstalk_pairs manually."
    },
    "sampling": {
      "distribution": "normal by default; LogNormal when spec entry has 'log_std' field (right-skewed error rates)",
      "lognormal_form": "val = mean * exp(N(-log_std**2/2, log_std)) -- mean-preserving, median ~ mean*exp(-log_std**2/2)",
      "lognormal_applies_to": "cx_fid_err, sqg_fid_err, data_init_error, data_measurement_error, measurement_spam_rate (right-skewed by physics; bad-qubit / bad-CX outliers)",
      "normal_applies_to": "t1, t2, *_length (relatively symmetric distributions)",
      "seed": "user-provided; same seed -> identical output",
      "fid_handling": "sample on error rate (1-fid), then convert back to fid; ensures fid <= 1",
      "physical_floor": "all params clipped to [physical_min, physical_max]"
    }
  },

  "_defect_overlay_doc": {
    "what": "Heterogeneous hot-spot model. Pick `qubit_fraction` × N_q qubits and `cx_fraction` × N_cx CX gates as defective. For each defective point, sample a subset of its candidate params and per-param multipliers ~ Uniform[mult_min, mult_max]. Everything driven by --defect-seed.",
    "physics": "Models real-chip post-calibration outliers — each defective qubit/CX has its own dominant defect type (some have bad readout, others bad CX, others high leakage), with various severity. NOT every param of a hot point degrades.",
    "canonical_param_order": {
      "hot_qubit": ["sqg_fid_err", "data_init_error", "data_measurement_error", "measurement_spam_rate", "lp"],
      "hot_cx":    ["cx_fid_err", "lp_propagation_prob"]
    },
    "consistency": "gen_level_params.py + gen_leakage_overrides.py must use same defect_seed AND iterate canonical param order so per-(point,param) multiplier matches across scripts."
  },
